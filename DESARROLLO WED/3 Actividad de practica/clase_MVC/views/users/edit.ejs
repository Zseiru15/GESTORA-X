<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head', { title: 'Editar usuario' }) %>

<body>
  <%- include('../partials/header') %>

  <h1>Detalle del usuario</h1>

  <h2></h2>

  <form class="registrar" action="../edit/<%= user.id %>?_method=put" method="POST">
    <label for="nombre">Nombre:</label><br>
    <input type="text" id="nombre" name="nombre" required value="<%= user.nombre %>"><br><br>

    <label for="apellido">Apellido:</label><br>
    <input type="text" id="apellido" name="apellido" required value="<%= user.apellido %>"><br><br>

    <label for="edad">Edad:</label><br>
    <input type="number" id="edad" name="edad" nin="0" max="120" required value="<%= user.edad %>"><br><br>

    <button type="submit">Guardar Cambios</button>
  </form>

  <%- include('../partials/footer') %>
</body>
</html>